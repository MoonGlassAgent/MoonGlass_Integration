{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonglass.local/schemas/ip_interface.schema.json",
  "title": "MoonGlass_Integration IP interface",
  "description": "Contract for one IP block: clocks, resets, ports, parameters, optional memory map. Agents must not invent ports that contradict this file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "name",
    "version",
    "ports"
  ],
  "properties": {
    "kind": {
      "const": "ip"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Snake_case IP identifier (module stem)."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?(-[a-z0-9.]+)?$",
      "description": "Semver-ish version of this interface contract."
    },
    "description": {
      "type": "string"
    },
    "hdl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "description": "RTL module name if different from name."
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Relative paths to RTL sources (optional hints)."
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "default"
        ],
        "properties": {
          "type": {
            "enum": [
              "int",
              "bit",
              "string"
            ]
          },
          "default": {},
          "description": {
            "type": "string"
          }
        }
      }
    },
    "clocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/clock"
      },
      "default": []
    },
    "resets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reset"
      },
      "default": []
    },
    "ports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/port"
      }
    },
    "memory_maps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/memory_map"
      },
      "default": []
    }
  },
  "$defs": {
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "frequency_hz": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "reset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "polarity"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "polarity": {
          "enum": [
            "active_low",
            "active_high"
          ]
        },
        "async": {
          "type": "boolean",
          "default": true
        },
        "description": {
          "type": "string"
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dir",
        "width"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "dir": {
          "enum": [
            "in",
            "out",
            "inout"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "protocol": {
          "type": "string",
          "description": "Logical protocol tag, e.g. apb3, axi4lite, irq, gpio, raw.",
          "examples": [
            "apb3",
            "axi4lite",
            "irq",
            "gpio",
            "raw",
            "uart"
          ]
        },
        "role": {
          "type": "string",
          "description": "Signal role within a protocol (e.g. psel, pready, txd). Not initiator/target — use bus_role for that.",
          "examples": [
            "psel",
            "penable",
            "paddr",
            "pwdata",
            "prdata",
            "pready",
            "pslverr",
            "pwrite",
            "txd",
            "rxd"
          ]
        },
        "bus_role": {
          "type": "string",
          "enum": [
            "initiator",
            "target",
            "monitor",
            "passthrough"
          ],
          "description": "Optional bus endpoint role for this port's protocol group (initiator/target/monitor/passthrough). Distinct from role (signal within protocol). Prefer the same bus_role on all ports that share one logical bus interface."
        },
        "bundle": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Optional logical bundle / interface group id (e.g. apb_s, uart_io). Ports sharing a bundle are wired together when a connection uses kind: bundle."
        },
        "clock_domain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Optional clock-domain tag for this port (often matches a clocks[].name). Used for CDC checks; not an HDL port."
        },
        "cdc": {
          "type": "string",
          "enum": [
            "none",
            "crossing",
            "async_handshake",
            "unknown"
          ],
          "description": "Optional CDC intent: none (same domain), crossing (needs synchronizer), async_handshake, or unknown. Cross-domain links without cdc!=none should be flagged."
        },
        "description": {
          "type": "string"
        }
      }
    },
    "memory_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bus",
        "size_bytes"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "bus": {
          "type": "string",
          "description": "Which port/protocol group this map attaches to."
        },
        "base_offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Offset within the parent address window (bytes)."
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "registers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "offset",
              "width"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "access": {
                "enum": [
                  "rw",
                  "ro",
                  "wo",
                  "w1c"
                ],
                "default": "rw"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
